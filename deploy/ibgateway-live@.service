[Unit]
Description=IB Gateway - LIVE for account %i (headless, via IBC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
# always, not on-failure - see ibgateway-live.service's own comment for
# the full reasoning (a missed 2FA push exits IBC cleanly, which
# on-failure never restarts, leaving the unit stuck dead until someone
# notices and restarts it by hand).
ExecStart=/opt/tradingbot/deploy/ibc/start-gateway.sh live %i
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
