# IBC (https://github.com/IbcAlpha/IBC) configuration for the PAPER-mode
# headless IB Gateway. Copy this to config-paper.ini, fill in your real
# credentials, and NEVER commit that file — it holds your IBKR password in
# plain text. (deploy/ibc/config-paper.ini is already in .gitignore.)
#
# Paper and live run as two SEPARATE, simultaneous IB Gateway processes on
# this box (see deploy/ibgateway-paper.service / ibgateway-live.service and
# DEPLOY.md) — this is the paper one. See config-live.ini.example for the
# live counterpart. IBKR often auto-creates a paper account sharing the
# live account's own login, but NOT always — some accounts have a genuinely
# separate paper username/password. Verify which applies to you (e.g. by
# logging into IBKR's website with each) rather than assuming they match;
# using the live credentials here when your paper account actually has its
# own separate login fails as "Unrecognized Username or Password" deep in
# IBC's log, while the Gateway process itself still starts and even accepts
# API socket connections — the symptom shows up downstream instead, as
# every real request (positions, historical data, contract qualification)
# timing out with no obvious link back to the credentials.
#
# This covers the settings that matter for this project. IBC ships its own
# reference config.ini with the full, authoritative list of every option —
# read that one too before you rely on this in production; IBC's own
# settings can change between releases.

# ---- credentials ----
IbLoginId=your_ibkr_username
IbPassword=your_ibkr_password
TradingMode=paper

# ---- unattended operation ----
# Accept the various one-time dialogs IBC would otherwise need a human to
# click through.
AcceptIncomingConnectionAction=accept
AllowBlindTrading=no
ReadOnlyLogin=no
AcceptNonBrokerageAccountWarning=yes
DismissPasswordExpiryWarning=yes
DismissNSEComplianceNotice=yes

# If a session is already open elsewhere (e.g. you logged into TWS on your
# laptop to check something), take over rather than failing to start.
ExistingSessionDetectedAction=primary

# ---- the 2FA reality check ----
# IBC can automate the username/password fields, but it CANNOT tap "Approve"
# on your phone for an IBKR Mobile push challenge — only you can do that.
# This just tells IBC how long to wait for you to do it, instead of giving
# up immediately.
SecondFactorAuthenticationTimeout=180

# AutoRestartTime is interpreted in the SERVER's system timezone, not ET -
# IBC has no separate timezone setting for it. If the server runs UTC (the
# usual default on cloud VMs, confirmed via `timedatectl`), "11:55 PM" here
# fires at 23:55 UTC (~7:55pm ET, mid-session), not near IBKR's own ~11:45pm
# ET reset as intended. Either convert this value to ET's current UTC
# offset yourself and accept it drifting an hour off twice a year at DST
# transitions, or (recommended) set the server's system timezone to
# America/New_York (`sudo timedatectl set-timezone America/New_York`) so
# this value and every server timestamp/log/cron just means ET directly and
# DST is handled automatically - verify with `timedatectl` before relying
# on either approach.
#
# AutoRestartTime makes IBC restart the Gateway session gracefully once a
# day (near IBKR's own server reset, ~11:45pm ET) WITHOUT a full logout, so
# in practice this avoids needing 2FA every single day. It does not
# guarantee IBKR will never ask again — expect to occasionally need to
# approve the push notification yourself, especially right after you first
# start the service. Don't design the rest of this deployment around "zero
# touch forever"; design it around "rare enough that a Telegram alert with
# no cycle data for a while is your signal to go check." Staggered by a few
# minutes from the live instance's restart time so the two don't both
# reconnect (and both potentially need 2FA) at the exact same moment.
AutoRestartTime=11:55 PM

# ---- logging ----
LogComponents=open
