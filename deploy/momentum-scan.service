[Unit]
Description=TradingBot momentum scanner - Scan + Alert (run_momentum.py)
# No IBKR dependency in phase 1: bars come from yfinance, alerts via
# Telegram. Only needs the network and the shared DB file.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
ExecStart=/opt/tradingbot/.venv/bin/python /opt/tradingbot/run_momentum.py --exec alert
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
