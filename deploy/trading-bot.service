[Unit]
Description=TradingBot trading engine (run_service.py)
After=ibgateway.service network-online.target
Wants=network-online.target
Requires=ibgateway.service

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
ExecStart=/opt/tradingbot/.venv/bin/python /opt/tradingbot/run_service.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
