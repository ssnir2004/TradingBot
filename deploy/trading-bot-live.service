[Unit]
Description=TradingBot trading engine - LIVE (run_service.py --mode live)
After=ibgateway-live.service network-online.target
Wants=network-online.target
Requires=ibgateway-live.service

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
# always, not on-failure - matches ibgateway-live.service's own reasoning:
# a deliberate `systemctl stop` never triggers Restart= regardless of
# policy, so there's no real downside, and it closes the same "exited
# cleanly but that wasn't actually success" gap here too.
ExecStart=/opt/tradingbot/.venv/bin/python /opt/tradingbot/run_service.py --mode live
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
