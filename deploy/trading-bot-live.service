[Unit]
Description=TradingBot trading engine - LIVE (run_service.py --mode live)
After=ibgateway-live.service network-online.target
Wants=network-online.target
Requires=ibgateway-live.service

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
ExecStart=/opt/tradingbot/.venv/bin/python /opt/tradingbot/run_service.py --mode live
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
