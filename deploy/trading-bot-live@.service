[Unit]
Description=TradingBot trading engine - LIVE for account %i (run_service.py --mode live --account-id %i)
After=ibgateway-live@%i.service network-online.target
Wants=network-online.target
Requires=ibgateway-live@%i.service

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
ExecStart=/opt/tradingbot/.venv/bin/python /opt/tradingbot/run_service.py --mode live --account-id %i
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
