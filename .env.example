# Paper and live run as two separate, always-on engines, connecting to two
# separate IB Gateway processes (see DEPLOY.md) — so every value that
# differs between them is PAPER_-/LIVE_-prefixed below rather than a single
# shared value with a switch. IBKR_HOST/IBKR_CLIENT_ID/IBKR_EXEC_CLIENT_ID
# stay shared: each mode's engine talks to a *different* Gateway process
# (different port), so there's no client-id collision between them even
# reusing the same numbers.
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3
IBKR_BACKTEST_CLIENT_ID=4
# IBKR_CLOSE_CLIENT_ID=13, IBKR_MODIFY_CLIENT_ID=14, IBKR_ORDER_CLIENT_ID=15,
# IBKR_MANUAL_ENTRY_CLIENT_ID=16, IBKR_PRICE_TRIGGER_CLIENT_ID=17, and
# IBKR_CANCEL_TRIGGER_CLIENT_ID=18 all have working defaults baked into
# their own scripts - only set them here if you need to change them.

# Gateway ports. 4002/4001 are IB Gateway's own defaults for paper/live —
# only change these if you've reconfigured Gateway's API port yourself.
PAPER_IBKR_PORT=4002
LIVE_IBKR_PORT=4001

# Risk sizing — keep PAPER_* generous for testing; LIVE_* MUST match your
# real account balance and your real risk tolerance. The bot sizes
# positions off PORTFOLIO_VALUE_USD, so a wrong value here directly means
# wrong position sizes with real money.
PAPER_PORTFOLIO_VALUE_USD=25000
PAPER_MAX_TRADES_PER_DAY=5
PAPER_MAX_RISK_PER_TRADE_PCT=1.0

LIVE_PORTFOLIO_VALUE_USD=0
LIVE_MAX_TRADES_PER_DAY=5
LIVE_MAX_RISK_PER_TRADE_PCT=1.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_URL=

# Dashboard session cookie signing key. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required — the dashboard refuses to start without it.
SESSION_SECRET=

# Encrypts each account's own IBKR username/password at rest (see
# src/secrets_store.py) — every account enters their own credentials
# through the dashboard, never through you. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Only needed once someone actually saves IBKR credentials from the
# dashboard; nothing else breaks if it's unset until then.
CREDENTIALS_ENCRYPTION_KEY=

# Only used by backtest_worker.py (see docs/worker.md) - a script meant to
# run on YOUR OWN computer, not the server, so these two are irrelevant to
# a normal server deployment. BACKTEST_WORKER_TOKEN is generated once from
# the dashboard's Backtest page (Remote Worker card) and shown only then.
BACKTEST_SERVER_URL=
BACKTEST_WORKER_TOKEN=
