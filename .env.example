# ---- Interactive Brokers connection ----
# TWS/IB Gateway must be running locally with the API enabled
# (File > Global Configuration > API > Settings > "Enable ActiveX and Socket Clients").
IBKR_HOST=127.0.0.1
# 7497 = TWS paper trading (default, safe). 7496 = TWS live. 4002 = Gateway paper. 4001 = Gateway live.
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# Safety switch. Must be explicitly set to "true" together with a live port (7496/4001)
# for the bot to ever place real-money orders. Leave "false" for paper trading.
ALLOW_LIVE_TRADING=false

# If true, orders are logged/alerted but never actually sent to IBKR. Useful for
# testing the strategy/scanner logic end-to-end without touching the account at all.
DRY_RUN=true

# ---- Telegram alerts (optional but recommended) ----
# Create a bot via @BotFather, then message it once and fetch your chat_id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Strategy / risk parameters ----
RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_PCT=3.0
PARTIAL_PROFIT_R_MULTIPLE=1.0
PARTIAL_PROFIT_SIZE_PCT=50
TRAILING_STOP_ATR_MULT=1.5

MIN_PRICE=5
MAX_PRICE=100
MIN_GAP_PCT=2.0
MIN_RELATIVE_VOLUME=2.0
MIN_AVG_DOLLAR_VOLUME=5000000

# Watchlist scanned every morning if no external scanner feed is wired up.
SCAN_UNIVERSE=AAPL,MSFT,NVDA,AMD,TSLA,AMZN,META,GOOGL

# ---- Schedule (US/Eastern) ----
PREMARKET_SCAN_TIME=08:00
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
FORCE_CLOSE_TIME=15:55
