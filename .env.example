# Paper and live run as two separate, always-on engines, connecting to two
# separate IB Gateway processes (see DEPLOY.md) — so every value that
# differs between them is PAPER_-/LIVE_-prefixed below rather than a single
# shared value with a switch. IBKR_HOST/IBKR_CLIENT_ID/IBKR_EXEC_CLIENT_ID
# stay shared: each mode's engine talks to a *different* Gateway process
# (different port), so there's no client-id collision between them even
# reusing the same numbers.
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3

# Gateway ports. 4002/4001 are IB Gateway's own defaults for paper/live —
# only change these if you've reconfigured Gateway's API port yourself.
PAPER_IBKR_PORT=4002
LIVE_IBKR_PORT=4001

# Risk sizing — keep PAPER_* generous for testing; LIVE_* MUST match your
# real account balance and your real risk tolerance. The bot sizes
# positions off PORTFOLIO_VALUE_USD, so a wrong value here directly means
# wrong position sizes with real money.
PAPER_PORTFOLIO_VALUE_USD=25000
PAPER_MAX_TRADES_PER_DAY=5
PAPER_MAX_RISK_PER_TRADE_PCT=1.0

LIVE_PORTFOLIO_VALUE_USD=0
LIVE_MAX_TRADES_PER_DAY=5
LIVE_MAX_RISK_PER_TRADE_PCT=1.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_URL=

# Dashboard session cookie signing key. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required — the dashboard refuses to start without it.
SESSION_SECRET=
