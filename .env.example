# Trading is always LIVE — real money (paper trading has been removed,
# see src/db.py's own MODES comment). Values below still carry a LIVE_
# prefix - see src/mode_config.py's RISK_PARAM_SPECS/risk_params, which
# build the env var name from the (always "live") mode at read time - kept
# as-is rather than renamed, since a fresh deploy behaves exactly the same
# either way and renaming would just be churn.
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3
IBKR_BACKTEST_CLIENT_ID=4
# IBKR_CLOSE_CLIENT_ID=13, IBKR_MODIFY_CLIENT_ID=14, IBKR_ORDER_CLIENT_ID=15,
# IBKR_MANUAL_ENTRY_CLIENT_ID=16, IBKR_PRICE_TRIGGER_CLIENT_ID=17, and
# IBKR_CANCEL_TRIGGER_CLIENT_ID=18 all have working defaults baked into
# their own scripts - only set them here if you need to change them.

# Gateway port. 4001 is IB Gateway's own default for live trading — only
# change this if you've reconfigured Gateway's API port yourself.
LIVE_IBKR_PORT=4001

# Risk sizing — MUST match your real account balance and your real risk
# tolerance. The bot sizes positions off PORTFOLIO_VALUE_USD, so a wrong
# value here directly means wrong position sizes with real money. These
# are only a fallback: the dashboard's Risk Settings screen (DB-backed)
# takes precedence once you've saved a value there — see
# src/mode_config.py's risk_params docstring.
LIVE_PORTFOLIO_VALUE_USD=0
LIVE_MAX_TRADES_PER_DAY=5
LIVE_MAX_RISK_PER_TRADE_PCT=1.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_URL=

# Dashboard session cookie signing key. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required — the dashboard refuses to start without it.
SESSION_SECRET=

# Encrypts each account's own IBKR username/password at rest (see
# src/secrets_store.py) — every account enters their own credentials
# through the dashboard, never through you. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Only needed once someone actually saves IBKR credentials from the
# dashboard; nothing else breaks if it's unset until then.
CREDENTIALS_ENCRYPTION_KEY=

# Only used by backtest_worker.py (see docs/worker.md) - a script meant to
# run on YOUR OWN computer, not the server, so these two are irrelevant to
# a normal server deployment. BACKTEST_WORKER_TOKEN is generated once from
# the dashboard's Backtest page (Remote Worker card) and shown only then.
BACKTEST_SERVER_URL=
BACKTEST_WORKER_TOKEN=
